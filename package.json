{
	"name": "bingo-control",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:mobile": "vite --host 0.0.0.0 --port 5173",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"dev:worker": "npm run build && wrangler dev --local",
		"db:local:init": "wrangler d1 execute bingo_control_db --local --file=./worker/schema.sql",
		"db:local:seed": "node ./scripts/create-local-seed.mjs",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@types/node": "^26.2.0",
		"typescript": "^5.5.4",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1"
	}
}
